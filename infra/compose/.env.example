# Required secret file paths. Each file must contain one deployment-specific value.
CURSOR_HMAC_KEY_FILE=
POSTGRES_ADMIN_PASSWORD_FILE=
POSTGRES_FLYWAY_PASSWORD_FILE=
POSTGRES_RUNTIME_PASSWORD_FILE=
REDIS_PASSWORD_FILE=
MINIO_ROOT_USER_FILE=
MINIO_ROOT_PASSWORD_FILE=
MINIO_APP_USER_FILE=
MINIO_APP_PASSWORD_FILE=

# Optional non-secret overrides. Blank uses the Compose default.
POSTGRES_DB=
POSTGRES_PORT=
KAFKA_PORT=
REDIS_PORT=
MINIO_API_PORT=
MINIO_CONSOLE_PORT=
OPA_PORT=
AI_PORT=
CORE_PORT=
AI_LOG_LEVEL=
APP_VERSION=
OBJECT_STORAGE_BUCKET=

# Stable IDs provisioned for authorizable runtime entities. These are identifiers, not secrets.
OCC_RISK_DUE_SYSTEM_PRINCIPAL_ID=00000000-0000-7000-8000-000000000040
OCC_RISK_METRICS_REPORT_RESOURCE_ID=00000000-0000-7000-8000-000000000041
